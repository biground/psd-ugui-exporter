{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PSD UGUI Exporter",
  "version": "0.1.0",
  "identifier": "com.biground.psdui-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PSD UGUI Editor",
        "width": 1200,
        "height": 800
      }
    ]
  },
  "bundle": {
    "resources": [
      "python/psd_worker.py"
    ]
  }
}
